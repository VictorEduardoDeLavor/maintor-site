# gerado por build-seo.py

RewriteEngine On

# 1) sempre HTTPS. A segunda condição não é redundante: quando o TLS termina
# num proxy à frente (o caso da Hostinger), %{HTTPS} chega como "off" mesmo já
# estando em HTTPS, e a regra entraria em LOOP de redirecionamento infinito.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2) /glossario/mtbf.html -> /glossario/mtbf (301, para não duplicar conteúdo)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) /glossario/mtbf serve glossario/mtbf.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 4) /glossario -> índice da pasta
DirectoryIndex index.html

ErrorDocument 404 /index.html

# cache: HTML curto (o conteúdo muda), estático longo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
